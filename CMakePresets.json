{
    "version": 3,
    "configurePresets": [
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":   "Debug",
                "CMAKE_PREFIX_PATH":  "C:/Qt/6.10.2/msvc2022_64"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "architecture": {
                "value": "x64",
