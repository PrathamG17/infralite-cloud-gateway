JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INFRALITE_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
INFRALITE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Set these only when bootstrapping initial role-specific test accounts.
# INFRALITE_BOOTSTRAP_QA_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# INFRALITE_BOOTSTRAP_VIEWER_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional OAuth 2.0 client-credentials grant. Keep the client secret at least 32 characters.
OAUTH_CLIENT_ID=infralite-client
OAUTH_CLIENT_SECRET=replace-with-a-random-secret-at-least-32-characters
OAUTH_CLIENT_ROLE=QA